all:
  vars:
    ansible_user: ansible
    linux:
      java_package: "openjdk-8-jdk"
      java_home_path: "/usr/lib/jvm/java-1.8.0-openjdk-arm64"
      python_version: "3.12"
    service_users:
      hadoop:
        name: hadoop
        group: hadoop
      hdfs:
        name: hdfs
        group: hadoop
      yarn:
        name: yarn
        group: hadoop
      mapred:
        name: mapred
        group: hadoop
      hive:
        name: hive
        group: hadoop
      kafka:
        name: kafka
        group: kafka
      spark:
        name: spark
        group: spark

    cluster_users:
      - name: bernhard
        group: bernhard

    services:
      - name: nn
        user: hdfs
      - name: sn
        user: hdfs
      - name: dn
        user: hdfs
      - name: rm
        user: yarn
      - name: nm
        user: yarn
      - name: jhs
        user: mapred
      - name: host
        user: hadoop
      - name: hive
        user: hive
      - name: HTTP
        user: hadoop
    ssl:
      keystore_file: "/etc/security/hadoop/keystore.jks"
      keystore_password: "bigdata"
      truststore_file: "/etc/security/hadoop/truststore.jks"
      truststore_password: "bigdata"
    kerberos:
      realm: "KAHOVEC.DEV"
      password: "Sup3rS3cur3Pa55w0rd!" # FIXME: use ansible vault
      keytab_path: /etc/security/keytab
    hadoop:
      version: "3.3.6"
      binaries_file: "hadoop-3.3.6.tar.gz"
      home_path: "/opt/hadoop"
      cluster_id: "hadoop_1"
      dirs:
        logs:
          path: /var/log/hadoop/
          owner: hdfs
          group: hadoop
          mode: "0770"
        namenode:
          path: /srv/hadoop/hdfs/name
          owner: hdfs
          group: hadoop
          mode: "0700"
        datanode:
          path: /srv/hadoop/hdfs/data
          owner: hdfs
          group: hadoop
          mode: "0700"
    tez:
      version: "0.10.4"
      home_path: "/opt/tez"
      hdfs_location: "/apps/tez-0.10.4"
      binaries_file: "apache-tez-0.10.4-bin.tar.gz"
    mysql:
      users:
        hive:
          name: "hive"
          password: "Sup3rS3cur3Pa55w0rd!"
          db: "hive_metastore"
          table: "*"
          privileges: "ALL"
    hive:
      version: "4.0.1"
      binaries_file: "apache-hive-4.0.1-bin.tar.gz"
      jdbc_file: "mysql-connector-j-8.4.0.jar"
      home_path: "/opt/hive"
      metastore:
        user: "hive"
        password: "Sup3rS3cur3Pa55w0rd!"
    hdfs:
      hadoop_dirs:
        root_dir:
          path: "/"
          owner: hdfs
          group: hadoop
          mode: "755"
        user_dir:
          path: "/user"
          owner: hdfs
          group: hadoop
          mode: "755"
        tmp_dir:
          path: "/tmp"
          owner: hdfs
          group: hadoop
          mode: "1777"
        yarn_remote_app_log_dir:
          path: "/tmp/logs"
          owner: yarn
          group: hadoop
          mode: "1777"
        yarn_mapreduce_am_staging_dir:
          path: "/tmp/hadoop-yarn/staging"
          owner: yarn
          group: hadoop
          mode: "1777"
        mapreduce_jobhistory_intermediate_done_dir:
          path: "/tmp/hadoop-yarn/staging/history/done_intermediate"
          owner: mapred
          group: hadoop
          mode: "1777"
        mapreduce_jobhistory_done_dir:
          path: "/tmp/hadoop-yarn/staging/history/done"
          owner: mapred
          group: hadoop
          mode: "750"
      hive_dirs:
        hive_tmp:
          path: "/tmp/hive"
          owner: hive
          group: hadoop
          mode: "1777"
        hive_managed_dir:
          path: "/warehouse/managed"
          owner: hive
          group: hive
          mode: "777"
        hive_external_dir:
          path: "/warehouse/external"
          owner: hive
          group: hive
          mode: "777"
    kafka:
      cluster_id: 2BKCbwzCTxyCNEM8XkkU1A
  children:
    cluster:
      children:
        controllers:
          hosts:
            rpic:
              kafka_node_id: 1

        workernodes:
          hosts:
            rpiw1:
              kafka_node_id: 2
            rpiw2:
              kafka_node_id: 3
            rpiw3:
              kafka_node_id: 4

        krb5server:
          hosts:
            rpic:

        krb5client:
          hosts:
            rpiw1:
            rpiw2:
            rpiw3:
