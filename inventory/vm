all:
  vars:
    users:
      hadoop:
        name: hadoop
        group: hadoop
      hdfs:
        name: hdfs
        group: hadoop
      yarn:
        name: yarn
        group: hadoop
      mapred:
        name: mapred
        group: hadoop
      hive:
        name: hive
        group: hadoop
      kafka:
        name: kafka
        group: kafka
      spark:
        name: spark
        group: spark
    services:
      - name: nn
        user: "{{ users.hdfs.name }}"
      - name: sn
        user: "{{ users.hdfs.name }}"
      - name: dn
        user: "{{ users.hdfs.name }}"
      - name: rm
        user: "{{ users.yarn.name }}"
      - name: nm
        user: "{{ users.yarn.name }}"
      - name: jhs
        user: "{{ users.mapred.name }}"
      - name: host
        user: "{{ users.hadoop.name }}"
      - name: hive
        user: "{{ users.hive.name }}"
    ssl:
      keystore_file: "/etc/security/hadoop/keystore.jks"
      truststore_file: "/etc/security/hadoop/truststore.jks"
    kerberos:
      realm: "KAHOVEC.DEV"
      password: "Sup3rS3cur3Pa55w0rd!"
      keytab_path: /etc/security/keytab/
    hadoop:
      version: "3.3.6"
      binaries_file:  "hadoop/hadoop-{{ hadoop.version }}.tar.gz"
      home_path: "/opt/hadoop"
    hdfs:
      dirs:
        root_dir: 
          path: "/"
          owner: "{{ users.hdfs.name }}"
          group: "{{ users.hadoop.group }}"
          mode: "755"
        user_dir: 
          path: "/user"
          owner: "{{ users.hdfs.name }}"
          group: "{{ users.hadoop.group }}"
          mode: "755"
        tmp_dir: 
          path: "/tmp"
          owner: "{{ users.hdfs.name }}"
          group: "{{ users.hadoop.group }}"
          mode: "1777"
        yarn_remote_app_log_dir: 
          path: "{{ hdfs.tmp_dir.path }}/logs"
          owner: "{{ users.yarn.name }}"
          group: "{{ users.hadoop.group }}"
          mode: "1777"
        yarn_mapreduce_am_staging_dir: 
          path: "/tmp/hadoop-yarn/staging"
          owner: "{{ users.yarn.name }}"
          group: "{{ users.hadoop.group }}"
          mode: "1777"
        mapreduce_jobhistory_intermediate_done_dir: 
          path: "{{ hdfs.yarn_mapreduce_am_staging_dir.path }}/history/done_intermediate"
          owner: "{{ users.mapred.name }}"
          group: "{{ users.hadoop.group }}"
          mode: "1777"
        mapreduce_jobhistory_done_dir: 
          path: "{{ hdfs.yarn_mapreduce_am_staging_dir.path }}/history/done"
          owner: "{{ users.mapred.name }}"
          group: "{{ users.hadoop.group }}"
          mode: "750"


    ansible_user: ansible
    kafka:
      cluster_id: 2BKCbwzCTxyCNEM8XkkU1A
    linux:
      java_package: "openjdk-8-jdk"
      java_home_path: "/usr/lib/jvm/java-1.8.0-openjdk-amd64"
      python_version: "3.10"
  children:
    cluster:
      children:
        controllers:
          hosts:
            vm-controller:
              kafka_node_id: 1

        namenodes:
          hosts:
            vm-controller:

        workernodes:
          hosts:
            vm-worker01:
              kafka_node_id: 2
            vm-worker02:
              kafka_node_id: 3
            vm-worker03:
              kafka_node_id: 4

        krb5server:
          hosts:
            vm-controller:

        krb5client:
          hosts:
            vm-worker01:
            vm-worker02:
            vm-worker03: