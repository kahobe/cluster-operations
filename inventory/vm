all:
  vars:
    ansible_user: ansible
    linux:
      java8_package: "openjdk-8-jdk"
      java8_home_path: "/usr/lib/jvm/java-1.8.0-openjdk-amd64"
      java17_package: "openjdk-17-jdk"
      java17_home_path: "/usr/lib/jvm/java-1.17.0-openjdk-amd64"
      python_version: "3.10"
    service_users:
      hadoop:
        name: hadoop
        group: hadoop
      hdfs:
        name: hdfs
        group: hadoop
      yarn:
        name: yarn
        group: hadoop
      mapred:
        name: mapred
        group: hadoop
      hive:
        name: hive
        group: hadoop
      kafka:
        name: kafka
        group: hadoop
      spark:
        name: spark
        group: hadoop

    cluster_users:
      - name: bernhard
        group: bernhard
      - name: testuser
        group: testuser
    services:
      - name: nn
        user: hdfs
      - name: sn
        user: hdfs
      - name: dn
        user: hdfs
      - name: rm
        user: yarn
      - name: nm
        user: yarn
      - name: jhs
        user: mapred
      - name: host
        user: hadoop
      - name: hive
        user: hive
      - name: HTTP
        user: hadoop
      - name: kafka
        user: kafka
    ssl:
      local_certs_dir: "certs_vm"
      keystore_file: "/etc/security/hadoop/keystore.jks"
      keystore_password: "bigdata"
      truststore_file: "/etc/security/hadoop/truststore.jks"
      truststore_password: "bigdata"
    kerberos:
      realm: "KAHOVECVM.DEV"
      password: "Sup3rS3cur3Pa55w0rd!" # FIXME: use ansible vault
      keytab_path: /etc/security/keytab
    hadoop:
      version: "3.3.6"
      binaries_file: "hadoop-3.3.6.tar.gz"
      home_path: "/opt/hadoop"
      cluster_id: "hadoop_1"
      dirs:
        logs:
          path: /var/log/hadoop/
          owner: hdfs
          group: hadoop
          mode: "0771"
        user_logs:
          path: /var/log/hadoop/userlogs
          owner: yarn
          group: hadoop
          mode: "1777"
        namenode:
          path: /srv/hadoop/hdfs/name
          owner: hdfs
          group: hadoop
          mode: "0700"
        datanode:
          path: /srv/hadoop/hdfs/data
          owner: hdfs
          group: hadoop
          mode: "0700"
    tez:
      version: "0.10.3"
      home_path: "/opt/tez"
      hdfs_location: "/apps/tez-0.10.3"
      binaries_file: "apache-tez-0.10.3-bin.tar.gz"
    kafka:
      version: "2.13-4.0.0"
      home_path: "/opt/kafka"
      binaries_file: "kafka_2.13-4.0.0.tgz"
      cluster_id: "2BKCbwzCTxyCNEM8XkkU1A"
      log_dir: "/var/kafka/kraft-combined-logs"
    mysql:
      users:
        hive:
          name: "hive"
          password: "Sup3rS3cur3Pa55w0rd!"
          db: "hive_metastore"
          table: "*"
          privileges: "ALL"
    hive:
      version: "4.0.0"
      binaries_file: "apache-hive-4.0.0-bin.tar.gz"
      jdbc_file: "mysql-connector-j-8.4.0.jar"
      home_path: "/opt/hive"
      metastore:
        user: "hive"
        password: "Sup3rS3cur3Pa55w0rd!"
    spark:
      version: "3.5.5"
      binaries_file: "spark-3.5.5-bin-hadoop3.tgz"
      home_path: "/opt/spark"
    hdfs:
      hadoop_dirs:
        root_dir:
          path: "/"
          owner: hdfs
          group: hadoop
          mode: "755"
        user_dir:
          path: "/user"
          owner: hdfs
          group: hadoop
          mode: "755"
        tmp_dir:
          path: "/tmp"
          owner: hdfs
          group: hadoop
          mode: "1777"
        yarn_remote_app_log_dir:
          path: "/tmp/logs"
          owner: yarn
          group: hadoop
          mode: "1777"
        yarn_mapreduce_am_staging_dir:
          path: "/tmp/hadoop-yarn/staging"
          owner: yarn
          group: hadoop
          mode: "1777"
        mapreduce_jobhistory_intermediate_done_dir:
          path: "/tmp/hadoop-yarn/staging/history/done_intermediate"
          owner: mapred
          group: hadoop
          mode: "1777"
        mapreduce_jobhistory_done_dir:
          path: "/tmp/hadoop-yarn/staging/history/done"
          owner: mapred
          group: hadoop
          mode: "750"
      hive_dirs:
        hive_tmp:
          path: "/tmp/hive"
          owner: hive
          group: hadoop
          mode: "1777"
        hive_managed_dir:
          path: "/warehouse/managed"
          owner: hive
          group: hive
          mode: "777"
        hive_external_dir:
          path: "/warehouse/external"
          owner: hive
          group: hive
          mode: "777"

  children:
    cluster:
      children:
        controllers:
          hosts:
            vm-controller:
              kafka_node_id: 1

        workernodes:
          hosts:
            vm-worker01:
              kafka_node_id: 2
            # vm-worker02:
            #   kafka_node_id: 3
            # vm-worker03:
            #   kafka_node_id: 4

