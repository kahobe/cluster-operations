[Unit]
Description=Hadoop DFS datanode
After=syslog.target network.target remote-fs.target nss-lookup.target network-online.target
Requires=network-online.target

[Service]
User={{ users.hdfs.name }}
Group={{ users.hadoop.group }}
Type=forking
ExecStart={{ hadoop.home_path }}/bin/hdfs --daemon start datanode
ExecStop={{ hadoop.home_path }}/bin/hdfs --daemon stop datanode
ExecStopPost={{ hadoop.home_path }}/bin/hdfs --daemon stop datanode
WorkingDirectory={{ hadoop.home_path }}
TimeoutStartSec=1min
Restart=no
RestartSec=30
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target