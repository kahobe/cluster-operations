[Unit]
Description=YARN nodemanager
After=syslog.target network.target remote-fs.target nss-lookup.target network-online.target
Requires=network-online.target

[Service]
User={{ users.yarn.name }}
Group={{ users.hadoop.group }}
Type=forking
ExecStart={{ hadoop.home_path }}/bin/yarn --daemon start nodemanager
ExecStop={{ hadoop.home_path }}/bin/yarn --daemon stop nodemanager
ExecStopPost={{ hadoop.home_path }}/bin/yarn --daemon stop nodemanager
WorkingDirectory={{ hadoop.home_path }}
TimeoutStartSec=1min
Restart=no
RestartSec=30
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target