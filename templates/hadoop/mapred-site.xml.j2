<?xml version="1.0"?>

<configuration>
    <property>
    <name>yarn.app.mapreduce.am.staging-dir</name>
    <value>{{ hdfs.dirs.yarn_mapreduce_am_staging_dir.path }}</value>
    <description>The staging dir used while submitting jobs.
    </description>
    </property>
    <property>
    <name>mapreduce.jobhistory.intermediate-done-dir</name>
    <value>{{ hdfs.dirs.mapreduce_jobhistory_intermediate_done_dir.path }}</value>
    <description></description>
    </property>
    <property>
    <name>mapreduce.jobhistory.done-dir</name>
    <value>{{ hdfs.dirs.mapreduce_jobhistory_done_dir.path }}</value>
    <description></description>
    </property>
    <property>
        <name>mapreduce.framework.name</name>
        <value>yarn</value>
    </property>
    <property>
        <name>mapreduce.application.classpath</name>
        <value>/opt/hadoop/etc/hadoop:/opt/hadoop/share/hadoop/common/lib/*:/opt/hadoop/share/hadoop/common/*:/opt/hadoop/share/hadoop/hdfs:/opt/hadoop/share/hadoop/hdfs/lib/*:/opt/hadoop/share/hadoop/hdfs/*:/opt/hadoop/share/hadoop/mapreduce/*:/opt/hadoop/share/hadoop/yarn:/opt/hadoop/share/hadoop/yarn/lib/*:/opt/hadoop/share/hadoop/yarn/*</value>
    </property>
    <property>
        <name>yarn.nodemanager.aux-services</name>
        <value>mapreduce_shuffle</value>
    </property>
    <property>
        <name>yarn.nodemanager.aux-services.mapreduce_shuffle.class</name>
        <value>org.apache.hadoop.mapred.ShuffleHandler</value>
    </property>
    <property>
        <name>mapreduce.jobhistory.address</name>
        <value>{{ groups['controllers'][0] }}:10020</value>
    </property>
    <property>
        <name>mapreduce.map.memory.mb</name>
        <value>-Xmx3686m</value>
    </property>
    <property>
        <name>mapreduce.map.java.opts</name>
        <value>-Xmx3686m</value>
    </property>
    <property>
        <name>mapreduce.reduce.memory.mb</name>
        <value>4096</value>
    </property>
    <property>
        <name>mapreduce.reduce.java.opts</name>
        <value>-Xmx3686m</value>
    </property>
    <property>
        <name>mapred.child.java.opts</name>
        <value>-Xmx1024m -server</value>
    </property>
    <property>
        <name>mapreduce.task.io.sort.mb</name>
        <value>1</value>
    </property>

    <property>
        <name>mapreduce.jobhistory.principal</name>
        <value>jhs/_HOST@KAHOVEC.DEV</value>
    </property>
    <property>
        <name>mapreduce.jobhistory.keytab</name>
        <value>/etc/security/keytab/jhs.service.keytab</value>
    </property>
</configuration>